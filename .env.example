PROJECT_NAME="O'zMU Jizzax filiali - Iqtidorli Talabalar Portali"

# JWT imzolash kaliti. Serverda ALBATTA o'zgartiring:  openssl rand -hex 32
SECRET_KEY=change-me-openssl-rand-hex-32

# PostgreSQL (parolda @ : / # kabi belgilar ishlatmang - DATABASE_URL ichiga tushadi)
POSTGRES_USER=talaba_user
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=iqtidorli_db
DATABASE_URL=postgresql+asyncpg://talaba_user:change-me-strong-password@db:5432/iqtidorli_db

# Standart super-administrator (entrypoint.sh birinchi ishga tushishda yaratadi)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-min-8-chars
# ADMIN_FULL_NAME="Tizim administratori"
# true bo'lsa har restartda parol .env dagi qiymatga qaytariladi (odatda false)
ADMIN_RESET_PASSWORD=false

# Demo/test ma'lumotlari - productionda false
SEED_DEMO_DATA=false

# Deployment (docker-compose.yml)
# Server: /iqtidorli-talaba (host nginx orqali). Lokal: bo'sh qoldiring -> http://lvh.me:8088/login
APP_BASE_PATH=/iqtidorli-talaba
# Lokal: COMPOSE_PROFILES=local (8088 da nginx konteyneri) va COOKIE_SECURE=false
# COMPOSE_PROFILES=local
# COOKIE_SECURE=false
BACKEND_PORT=8092
FRONTEND_PORT=5179

# HEMIS OAuth 2.0 (SSO). CLIENT_ID bo'sh bo'lsa "HEMIS orqali kirish" tugmalari ko'rinmaydi.
# REDIRECT_URI HEMIS admin panelidagi "URL manzil" bilan bitma-bit bir xil bo'lsin.
HEMIS_OAUTH_BASE_URL=https://hemis.jbnuu.uz
HEMIS_OAUTH_STUDENT_BASE_URL=https://student.jbnuu.uz
HEMIS_OAUTH_AUTHORIZE_PATH=/oauth/authorize
HEMIS_OAUTH_TOKEN_PATH=/oauth/access-token
HEMIS_OAUTH_USERINFO_PATH=/oauth/api/user?fields=id,uuid,type,roles,name,login,picture,university_id,departments
HEMIS_OAUTH_STUDENT_USERINFO_PATH=/oauth/api/user?fields=id,uuid,type,name,login,picture,university_id,group,faculty,level,semester,specialty
HEMIS_OAUTH_CLIENT_ID=
HEMIS_OAUTH_CLIENT_SECRET=
HEMIS_OAUTH_REDIRECT_URI=https://jbnuu.uz/iqtidorli-talaba/login
